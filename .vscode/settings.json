{
  "python.defaultInterpreterPath": "${workspaceFolder}/v2/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/v2",
  "python.testing.pytestArgs": [
    "-c",
    "pyproject.toml",
    "test_workflow.py",
    "test_workflow_direct_api.py",
    "test_activity_time_skipping.py",
    "test_activity_time_skipping_direct_api.py"
  ],
  "python.envFile": "${workspaceFolder}/v2/.env",
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/v2"
  ],
  "python.terminal.useEnvFile": true,
  "python.terminal.launchArgs": [
    "-m",
    "pytest"
  ],
  "python.terminal.executeInFileDir": true
}
